@model SmartRestaurant.Application.DTOs.Products.ProductDto
@{
    ViewData["Title"] = "Detalles del producto";
    var estadoClase = Model.IsActive ? "sr-status-confirmed" : "sr-status-cancelled";
    var estadoTexto = Model.IsActive ? "Activo" : "Inactivo";
    var categoria = Model.CategoryName ?? "Sin categoría";
}

<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<section class="sr-page sr-create sr-details-page py-4">

    <div class="sr-header mb-4">
        <div>
            <p class="sr-eyebrow mb-2">SMARTRESTAURANT / PRODUCTOS</p>
            <h1 class="sr-title">Detalles del producto</h1>
            <p class="sr-subtitle mb-0">Consulta la información del producto #@Model.Id.</p>
        </div>

        <a asp-action="Index" class="btn sr-back-btn">&larr; Volver a productos</a>
    </div>

    <div class="sr-details-grid">

        <article class="sr-form-panel">
            <div class="sr-panel-header">
                <div>
                    <h2>Información del producto</h2>
                    <p>Datos registrados en el sistema.</p>
                </div>
                <span class="sr-status @estadoClase">@estadoTexto</span>
            </div>

            <div class="sr-panel-body">
                <dl class="sr-detail-list">
                    <div class="sr-detail-item">
                        <dt>ID de producto</dt>
                        <dd>#@Model.Id</dd>
                    </div>
                    <div class="sr-detail-item">
                        <dt>Nombre</dt>
                        <dd>@Model.Name</dd>
                    </div>
                    <div class="sr-detail-item">
                        <dt>Descripción</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
                    </div>
                    <div class="sr-detail-item">
                        <dt>Categoría</dt>
                        <dd>@categoria</dd>
                    </div>
                    <div class="sr-detail-item">
                        <dt>Precio</dt>
                        <dd>RD$ @Model.Price.ToString("N2")</dd>
                    </div>
                    <div class="sr-detail-item">
                        <dt>Estado</dt>
                        <dd><span class="sr-status @estadoClase">@estadoTexto</span></dd>
                    </div>
                </dl>

                <div class="sr-form-divider"></div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary sr-primary-btn">Editar producto</a>
                    <a asp-action="Index" class="btn sr-back-btn">Volver al listado</a>
                </div>
            </div>
        </article>

        <aside class="sr-details-side">
            <div class="sr-form-panel">
                <div class="sr-panel-header">
                    <div>
                        <h2>Resumen</h2>
                        <p>Información principal.</p>
                    </div>
                </div>

                <div class="sr-panel-body">
                    <div class="sr-detail-highlight">
                        <span>Precio</span>
                        <strong>RD$ @Model.Price.ToString("N2")</strong>
                    </div>
                    <div class="sr-summary-line">
                        <span>Categoría</span>
                        <strong>@categoria</strong>
                    </div>
                    <div class="sr-summary-line">
                        <span>Estado</span>
                        <strong>@estadoTexto</strong>
                    </div>
                </div>
            </div>

            <div class="sr-information mt-3">
                <strong>Información importante</strong>
                <p>Un producto inactivo no se puede agregar a pedidos nuevos.</p>
            </div>
        </aside>

    </div>
</section>