@model SmartRestaurant.Web.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Editar producto";
}

<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<section class="sr-page sr-create sr-edit-page py-4">

    <div class="sr-header mb-4">
        <div>
            <p class="sr-eyebrow mb-2">SMARTRESTAURANT / PRODUCTOS</p>
            <h1 class="sr-title">Editar producto</h1>
            <p class="sr-subtitle mb-0">Modifica la información del producto #@Model.Id.</p>
        </div>

        <a asp-action="Index" class="btn sr-back-btn">&larr; Volver a productos</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger sr-validation-summary" role="alert"></div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="sr-form-panel">

                    <div class="sr-panel-header">
                        <div>
                            <h2>Datos del producto</h2>
                            <p>Actualiza nombre, precio o categoría.</p>
                        </div>
                        <span class="sr-panel-number">01</span>
                    </div>

                    <div class="sr-panel-body">

                        <div class="mb-4">
                            <label asp-for="Name" class="sr-field-label"></label>
                            <span class="sr-required">*</span>
                            <input asp-for="Name" class="form-control sr-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="sr-field-label"></label>
                            <textarea asp-for="Description" class="form-control sr-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="sr-field-label"></label>
                                <span class="sr-required">*</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control sr-control" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="sr-field-label"></label>
                                <span class="sr-required">*</span>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select sr-control">
                                    <option value="0">Selecciona una categoría...</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="sr-form-divider"></div>

                        <button type="submit" class="btn btn-primary sr-primary-btn w-100">Guardar cambios</button>
                        <a asp-action="Index" class="btn sr-cancel-btn w-100 mt-2">Cancelar</a>
                    </div>

                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}