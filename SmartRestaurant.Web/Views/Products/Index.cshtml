@model SmartRestaurant.Web.ViewModels.ProductIndexViewModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Productos</h1>
        <p class="text-muted mb-0">Administra el catálogo y los precios de venta.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (!Model.Products.Any())
{
    <div class="alert alert-light border">
        Aún no hay productos. Registra productos para poder crear pedidos.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Precio</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td class="text-end">RD$ @product.Price.ToString("N2")</td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>
                                    <form asp-action="SetActive" method="post">
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <input type="hidden" name="isActive" value="@(!product.IsActive)" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            @(product.IsActive ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
