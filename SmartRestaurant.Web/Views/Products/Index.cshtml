@model List<SmartRestaurant.Web.ViewModels.ProductListItemViewModel>
@{
    ViewData["Title"] = "Productos";

    var productos = Model ?? new List<SmartRestaurant.Web.ViewModels.ProductListItemViewModel>();
    var total = productos.Count;
    var activos = productos.Count(p => p.IsActive);
    var inactivos = total - activos;
}

<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<section class="sr-page py-4">

    <!-- Encabezado -->
    <div class="sr-header mb-4">
        <div>
            <p class="sr-eyebrow mb-2">SMARTRESTAURANT / CATÁLOGO</p>
            <h1 class="sr-title">Productos</h1>
            <p class="sr-subtitle mb-0">Gestiona los productos del menú y sus precios.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary sr-primary-btn">
            <span aria-hidden="true">＋</span>
            Nuevo producto
        </a>
    </div>

    <!-- Mensaje de confirmación -->
    @if (TempData["Success"] is string mensaje)
    {
        <div class="alert alert-success sr-alert" role="status">@mensaje</div>
    }

    <!-- Tarjetas de resumen -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="sr-stat-card">
                <div class="sr-stat-top">
                    <span>Total de productos</span>
                    <span class="sr-stat-icon sr-blue">#</span>
                </div>
                <h2>@total</h2>
                <p>Productos registrados</p>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="sr-stat-card">
                <div class="sr-stat-top">
                    <span>Activos</span>
                    <span class="sr-stat-icon sr-green">✓</span>
                </div>
                <h2>@activos</h2>
                <p>Disponibles para pedidos</p>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="sr-stat-card">
                <div class="sr-stat-top">
                    <span>Inactivos</span>
                    <span class="sr-stat-icon sr-red">×</span>
                </div>
                <h2>@inactivos</h2>
                <p>No disponibles para pedidos</p>
            </div>
        </div>
    </div>

    <!-- Listado principal -->
    <div class="sr-card">

        <div class="sr-card-header">
            <div>
                <h2>Listado de productos</h2>
                <p>Información de los productos registrados.</p>
            </div>

            <div class="sr-search">
                <label for="buscarProducto" class="visually-hidden">Buscar producto</label>
                <input type="search" id="buscarProducto" class="form-control"
                       placeholder="Buscar producto o categoría..." autocomplete="off" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table sr-table mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (productos.Any())
                    {
                        @foreach (var producto in productos)
                        {
                            var estadoClase = producto.IsActive ? "sr-status-confirmed" : "sr-status-cancelled";

                            <tr class="sr-search-row" data-search="@($"{producto.Name} {producto.CategoryName}".ToLowerInvariant())">
                                <td class="sr-id">#@producto.Id</td>
                                <td><span class="sr-client">@producto.Name</span></td>
                                <td>@producto.CategoryName</td>
                                <td>RD$ @producto.Price.ToString("N2")</td>
                                <td>
                                    <span class="sr-status @estadoClase">
                                        @(producto.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="sr-actions">
                                        <a asp-action="Details" asp-route-id="@producto.Id" class="sr-action">Ver</a>
                                        <a asp-action="Edit" asp-route-id="@producto.Id" class="sr-action">Editar</a>
                                        <form asp-action="ToggleActive" asp-route-id="@producto.Id" method="post" class="d-inline">
                                            <button type="submit" class="sr-action">
                                                @(producto.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="sr-empty">
                                <div class="sr-empty-content">
                                    <h3>No hay productos registrados</h3>
                                    <p>Crea un producto para comenzar a armar el menú.</p>
                                    <a asp-action="Create" class="btn btn-outline-primary">Crear producto</a>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="sinResultados" class="d-none">
                        <td colspan="6" class="sr-empty">No se encontraron productos con esa búsqueda.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="sr-card-footer">
            <span>Total registrado: <strong>@total</strong></span>
        </div>
    </div>

</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buscador = document.getElementById("buscarProducto");
            const filas = document.querySelectorAll(".sr-search-row");
            const sinResultados = document.getElementById("sinResultados");

            if (!buscador) return;

            buscador.addEventListener("input", function () {
                const texto = buscador.value.trim().toLowerCase();
                let visibles = 0;

                filas.forEach(function (fila) {
                    const coincide = (fila.dataset.search || "").includes(texto);
                    fila.classList.toggle("d-none", !coincide);
                    if (coincide) visibles++;
                });

                sinResultados.classList.toggle("d-none", visibles > 0 || filas.length === 0);
            });
        });
    </script>
}