@model SmartRestaurant.Application.DTOs.Products.CreateProductDto
@{
    ViewData["Title"] = "Nuevo producto";
    var categorias = ViewData["Categories"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />

<section class="sr-page sr-create py-4">

    <div class="sr-header mb-4">
        <div>
            <p class="sr-eyebrow mb-2">SMARTRESTAURANT / PRODUCTOS</p>
            <h1 class="sr-title">Nuevo producto</h1>
            <p class="sr-subtitle mb-0">Registra un producto del menú con su precio y categoría.</p>
        </div>

        <a asp-action="Index" class="btn sr-back-btn">&larr; Volver a productos</a>
    </div>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger sr-validation-summary" role="alert"></div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="sr-form-panel">

                    <div class="sr-panel-header">
                        <div>
                            <h2>Datos del producto</h2>
                            <p>Nombre, precio y categoría.</p>
                        </div>
                        <span class="sr-panel-number">01</span>
                    </div>

                    <div class="sr-panel-body">

                        <div class="mb-4">
                            <label asp-for="Name" class="sr-field-label"></label>
                            <span class="sr-required">*</span>
                            <input asp-for="Name" class="form-control sr-control" placeholder="Ej. Pollo a la plancha" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="sr-field-label"></label>
                            <textarea asp-for="Description" class="form-control sr-control" rows="3" placeholder="Opcional"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="sr-field-label"></label>
                                <span class="sr-required">*</span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control sr-control" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="sr-field-label"></label>
                                <span class="sr-required">*</span>
                                <select asp-for="CategoryId" asp-items="categorias" class="form-select sr-control">
                                    <option value="">Selecciona una categoría...</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (!categorias.Any())
                        {
                            <p class="sr-warning-note mt-3">
                                No hay categorías activas. Crea una categoría antes de registrar productos.
                            </p>
                        }

                        <div class="sr-form-divider"></div>

                        <button type="submit" class="btn btn-primary sr-primary-btn w-100">Guardar producto</button>
                        <a asp-action="Index" class="btn sr-cancel-btn w-100 mt-2">Cancelar</a>
                    </div>

                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}