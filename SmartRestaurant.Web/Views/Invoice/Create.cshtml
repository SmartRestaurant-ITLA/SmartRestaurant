@model SmartRestaurant.Web.ViewModels.InvoiceCreateViewModel
@{
    ViewData["Title"] = "Nueva factura";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Nueva factura</h1>
        <p class="text-muted mb-0">Solo se pueden facturar pedidos servidos que aún no tengan factura.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a facturación</a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    @if (Model.EligibleOrders.Count == 0)
    {
        <div class="alert alert-light border">
            No hay pedidos servidos disponibles para facturar.
            <a asp-controller="Orders" asp-action="Index">Consultar pedidos</a>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="OrderId" class="form-label">Pedido</label>
                    <select asp-for="OrderId" class="form-select">
                        <option value="0">Selecciona un pedido</option>
                        @foreach (var order in Model.EligibleOrders)
                        {
                            <option value="@order.Id">
                                Pedido #@order.Id · Mesa @order.TableNumber ·
                                @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ·
                                RD$ @order.Total.ToString("N2")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="OrderId" class="text-danger"></span>
                </div>
                <p class="text-muted mb-0">
                    La factura conservará los nombres, precios y cantidades registrados en el pedido.
                </p>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Generar factura</button>
    }

    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
