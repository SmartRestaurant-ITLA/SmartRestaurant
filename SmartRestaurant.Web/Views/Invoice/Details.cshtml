@model SmartRestaurant.Web.ViewModels.InvoiceDetailsViewModel
@{
    ViewData["Title"] = $"Factura {Model.Invoice.InvoiceNumber}";

    string GetStatusLabel(SmartRestaurant.Domain.Enums.InvoiceStatus status) => status switch
    {
        SmartRestaurant.Domain.Enums.InvoiceStatus.Issued => "Emitida",
        SmartRestaurant.Domain.Enums.InvoiceStatus.PartiallyPaid => "Pago parcial",
        SmartRestaurant.Domain.Enums.InvoiceStatus.Paid => "Pagada",
        SmartRestaurant.Domain.Enums.InvoiceStatus.Cancelled => "Cancelada",
        _ => status.ToString()
    };

    string GetPaymentMethodLabel(SmartRestaurant.Domain.Enums.PaymentMethod method) => method switch
    {
        SmartRestaurant.Domain.Enums.PaymentMethod.Cash => "Efectivo",
        SmartRestaurant.Domain.Enums.PaymentMethod.CreditCard => "Tarjeta de crédito",
        SmartRestaurant.Domain.Enums.PaymentMethod.DebitCard => "Tarjeta de débito",
        SmartRestaurant.Domain.Enums.PaymentMethod.BankTransfer => "Transferencia bancaria",
        SmartRestaurant.Domain.Enums.PaymentMethod.Other => "Otro",
        _ => method.ToString()
    };

    var canRegisterPayment = Model.Invoice.Status is
        SmartRestaurant.Domain.Enums.InvoiceStatus.Issued or
        SmartRestaurant.Domain.Enums.InvoiceStatus.PartiallyPaid
        && Model.Invoice.Balance > 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Factura @Model.Invoice.InvoiceNumber</h1>
        <p class="text-muted mb-0">
            Pedido #@Model.Invoice.OrderId ·
            Emitida @Model.Invoice.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a facturación</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<div asp-validation-summary="All" class="alert alert-danger"></div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Estado</div>
            <div class="fw-semibold">@GetStatusLabel(Model.Invoice.Status)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Total</div>
            <div class="fw-semibold">RD$ @Model.Invoice.Total.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Pagado</div>
            <div class="fw-semibold">RD$ @Model.Invoice.AmountPaid.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Balance pendiente</div>
            <div class="fw-semibold">RD$ @Model.Invoice.Balance.ToString("N2")</div>
        </div></div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Productos facturados</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Precio unitario</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.Invoice.Details)
                {
                    <tr>
                        <td>@detail.ProductName</td>
                        <td class="text-end">RD$ @detail.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@detail.Quantity</td>
                        <td class="text-end">RD$ @detail.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3">Total</td>
                    <td class="text-end">RD$ @Model.Invoice.Total.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Pagos</h2></div>
    @if (Model.Invoice.Payments.Count == 0)
    {
        <div class="card-body text-muted">Esta factura todavía no tiene pagos registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th class="text-end">Importe</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Invoice.Payments)
                    {
                        <tr>
                            <td>@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@GetPaymentMethodLabel(payment.Method)</td>
                            <td>@(string.IsNullOrWhiteSpace(payment.Reference) ? "—" : payment.Reference)</td>
                            <td class="text-end">RD$ @payment.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (canRegisterPayment)
{
    <div class="card">
        <div class="card-header"><h2 class="h5 mb-0">Registrar pago</h2></div>
        <div class="card-body">
            <form asp-action="RegisterPayment" asp-route-id="@Model.Invoice.Id" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="Payment.Amount" class="form-label">Importe</label>
                        <input asp-for="Payment.Amount" class="form-control" type="number" min="0.01"
                               max="@Model.Invoice.Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               step="0.01" />
                        <span asp-validation-for="Payment.Amount" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Payment.PaymentDate" class="form-label">Fecha de pago</label>
                        <input asp-for="Payment.PaymentDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Payment.PaymentDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Payment.Method" class="form-label">Método de pago</label>
                        <select asp-for="Payment.Method" class="form-select">
                            @foreach (SmartRestaurant.Domain.Enums.PaymentMethod method in
                                Enum.GetValues(typeof(SmartRestaurant.Domain.Enums.PaymentMethod)))
                            {
                                <option value="@((int)method)">@GetPaymentMethodLabel(method)</option>
                            }
                        </select>
                        <span asp-validation-for="Payment.Method" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Payment.Reference" class="form-label">Referencia (opcional)</label>
                        <input asp-for="Payment.Reference" class="form-control" maxlength="100" />
                        <span asp-validation-for="Payment.Reference" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Guardar pago</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
