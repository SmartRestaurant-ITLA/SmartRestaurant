@model SmartRestaurant.Web.ViewModels.OrderIndexViewModel
@{
    ViewData["Title"] = "Pedidos";

    string GetStatusLabel(SmartRestaurant.Domain.Enums.OrderStatus status) => status switch
    {
        SmartRestaurant.Domain.Enums.OrderStatus.Pending => "Pendiente",
        SmartRestaurant.Domain.Enums.OrderStatus.InPreparation => "En preparación",
        SmartRestaurant.Domain.Enums.OrderStatus.Served => "Servido",
        SmartRestaurant.Domain.Enums.OrderStatus.Cancelled => "Cancelado",
        _ => status.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Pedidos</h1>
        <p class="text-muted mb-0">Consulta pedidos y su estado de preparación.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo pedido</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (!Model.Orders.Any())
{
    <div class="alert alert-light border">
        Aún no hay pedidos registrados.
        <a asp-action="Create">Crear el primer pedido</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Mesa</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Artículos</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>Mesa @order.TableNumber</td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@GetStatusLabel(order.Status)</td>
                            <td class="text-end">@order.DetailCount</td>
                            <td class="text-end">RD$ @order.Total.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Detalles
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
