@model SmartRestaurant.Web.ViewModels.OrderCreateViewModel
@{
    ViewData["Title"] = "Nuevo pedido";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Nuevo pedido</h1>
        <p class="text-muted mb-0">Selecciona una mesa y los productos solicitados.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a pedidos</a>
</div>

@if (Model.AvailableTables.Count == 0)
{
    <div class="alert alert-warning">
        No hay mesas activas disponibles para asignar el pedido.
    </div>
}
@if (Model.AvailableProducts.Count == 0)
{
    <div class="alert alert-warning">
        Registra al menos un producto activo antes de crear un pedido.
        <a asp-controller="Products" asp-action="Create">Crear producto</a>
    </div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="TableId" class="form-label"></label>
                <select asp-for="TableId" asp-items="Model.AvailableTables" class="form-select">
                    <option value="">Selecciona una mesa</option>
                </select>
                <span asp-validation-for="TableId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Productos</h2>
            <button type="button" id="addOrderDetail" class="btn btn-sm btn-outline-primary">
                Agregar producto
            </button>
        </div>
        <div class="card-body">
            <div id="orderDetails">
                @for (var index = 0; index < Model.Details.Count; index++)
                {
                    <div class="order-detail-row row align-items-end g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="Details[index].ProductId" class="form-label"></label>
                            <select asp-for="Details[index].ProductId"
                                    class="form-select"
                                    data-field="ProductId">
                                <option value="0">Selecciona un producto</option>
                                @foreach (var product in Model.AvailableProducts)
                                {
                                    <option value="@product.Id"
                                            data-product-name="@product.Name"
                                            data-price="@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                        @product.Name — RD$ @product.Price.ToString("N2")
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="Details[index].ProductId" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Details[index].Quantity" class="form-label"></label>
                            <input asp-for="Details[index].Quantity"
                                   class="form-control"
                                   min="1"
                                   data-field="Quantity" />
                            <span asp-validation-for="Details[index].Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-danger remove-order-detail">
                                Quitar
                            </button>
                        </div>
                    </div>
                }
            </div>
            <p class="text-muted mb-0">
                Los precios del resumen son estimados. El servidor vuelve a obtenerlos del catálogo y calcula los importes definitivos.
            </p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">Resumen del pedido</h2>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody id="orderSummaryBody">
                    <tr>
                        <td colspan="4" class="text-muted">Selecciona productos para ver el resumen.</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3">Total estimado</td>
                        <td id="orderSummaryTotal" class="text-end">RD$ 0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <button type="submit"
            class="btn btn-primary"
            disabled="@(Model.AvailableTables.Count == 0 || Model.AvailableProducts.Count == 0 ? "disabled" : null)">
        Crear pedido
    </button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

<template id="orderDetailTemplate">
    <div class="order-detail-row row align-items-end g-3 mb-3">
        <div class="col-md-7">
            <label class="form-label">Producto</label>
            <select class="form-select" data-field="ProductId" required>
                <option value="">Selecciona un producto</option>
                @foreach (var product in Model.AvailableProducts)
                {
                    <option value="@product.Id"
                            data-product-name="@product.Name"
                            data-price="@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                        @product.Name — RD$ @product.Price.ToString("N2")
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Cantidad</label>
            <input type="number" class="form-control" min="1" value="1" data-field="Quantity" required />
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-danger remove-order-detail">Quitar</button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const details = document.getElementById("orderDetails");
            const template = document.getElementById("orderDetailTemplate");
            const summaryBody = document.getElementById("orderSummaryBody");
            const summaryTotal = document.getElementById("orderSummaryTotal");

            function formatAmount(amount) {
                return `RD$ ${new Intl.NumberFormat("es-DO", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(amount)}`;
            }

            function updateSummary() {
                summaryBody.replaceChildren();
                let total = 0;
                let itemCount = 0;

                details.querySelectorAll(".order-detail-row").forEach(function (row) {
                    const productSelect = row.querySelector('[data-field="ProductId"]');
                    const quantityInput = row.querySelector('[data-field="Quantity"]');
                    const option = productSelect.selectedOptions[0];
                    const unitPrice = Number(option.dataset.price);
                    const rawQuantity = Number.parseInt(quantityInput.value, 10);

                    if (!option.value || !Number.isFinite(unitPrice)) {
                        return;
                    }

                    const quantity = Number.isFinite(rawQuantity) && rawQuantity > 0
                        ? rawQuantity
                        : 0;
                    const subtotal = unitPrice * quantity;
                    total += subtotal;
                    itemCount++;

                    const tableRow = document.createElement("tr");
                    const productCell = document.createElement("td");
                    const priceCell = document.createElement("td");
                    const quantityCell = document.createElement("td");
                    const subtotalCell = document.createElement("td");

                    productCell.textContent = option.dataset.productName;
                    priceCell.className = "text-end";
                    priceCell.textContent = formatAmount(unitPrice);
                    quantityCell.className = "text-end";
                    quantityCell.textContent = quantity.toString();
                    subtotalCell.className = "text-end";
                    subtotalCell.textContent = formatAmount(subtotal);

                    tableRow.append(productCell, priceCell, quantityCell, subtotalCell);
                    summaryBody.appendChild(tableRow);
                });

                if (itemCount === 0) {
                    const emptyRow = document.createElement("tr");
                    const emptyCell = document.createElement("td");
                    emptyCell.colSpan = 4;
                    emptyCell.className = "text-muted";
                    emptyCell.textContent = "Selecciona productos para ver el resumen.";
                    emptyRow.appendChild(emptyCell);
                    summaryBody.appendChild(emptyRow);
                }

                summaryTotal.textContent = formatAmount(total);
            }

            function reindexRows() {
                details.querySelectorAll(".order-detail-row").forEach(function (row, index) {
                    row.querySelectorAll("[data-field]").forEach(function (field) {
                        const property = field.dataset.field;
                        field.name = `Details[${index}].${property}`;
                        field.id = `Details_${index}__${property}`;
                    });
                });

                updateSummary();
            }

            document.getElementById("addOrderDetail").addEventListener("click", function () {
                details.appendChild(template.content.cloneNode(true));
                reindexRows();
            });

            details.addEventListener("click", function (event) {
                if (!event.target.classList.contains("remove-order-detail")) {
                    return;
                }

                event.target.closest(".order-detail-row").remove();
                if (details.querySelectorAll(".order-detail-row").length === 0) {
                    details.appendChild(template.content.cloneNode(true));
                }

                reindexRows();
            });

            details.addEventListener("change", updateSummary);
            details.addEventListener("input", updateSummary);
            reindexRows();
        });
    </script>
}
