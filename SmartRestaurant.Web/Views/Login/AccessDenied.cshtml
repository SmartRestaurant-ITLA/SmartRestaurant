@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-danger mb-2" aria-hidden="true">&#128274;</div>
                    <h3 class="mb-3">Acceso denegado</h3>
                    <p class="text-muted mb-4">
                        No tienes permiso para ver esta página.
                        Si crees que es un error, consulta con el administrador del sistema.
                    </p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
                        <a asp-controller="Login" asp-action="Index" class="btn btn-outline-secondary">Iniciar sesión con otra cuenta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>